---
import Base from './Base.astro';
import SidebarItems from '../components/SidebarItems.astro';
import DrawerProducts from '../components/DrawerProducts.astro';
import type { NavItem, Page } from '../lib/content';
import { icon } from '../lib/icons';
import { encodePath } from '../lib/markdown';
import { site } from '../config/products';

type Props = { page: Page; nav: NavItem[]; prev: Page | null; next: Page | null; eyebrow: string; productIndex: Page | null };
const { page, nav, prev, next, eyebrow, productIndex } = Astro.props;

// Top-level folders become headed sections (Mintlify style); loose top-level pages
// go in a first, untitled section under the product overview.
const loose = nav.filter((i) => i.type === 'page');
const sections = nav.filter((i) => i.type === 'group');
const crumbs = [
  { name: 'Docs', path: '/' },
  { name: page.product.name, path: `/${encodePath(page.product.id)}/` },
  ...(productIndex && productIndex.slug !== page.slug ? [{ name: page.title, path: `/${encodePath(page.slug)}` }] : []),
];
const markdownPath = `/${encodePath(page.slug.replace(/\/$/, ''))}.md`;
const askPrompt = encodeURIComponent(`Read ${site.url}${markdownPath} so I can ask questions about it.`);
const updated = page.updated?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={page.title} description={page.summary} productId={page.product.id} crumbs={crumbs} updated={page.updated} hasSidebar>
  <div class="container docs-grid">
    <aside class="sidebar" id="sidebar" aria-label={`${page.product.name} navigation`}>
      <nav>
        <div class="nav-section">
          <ul class="nav-list">
            {
              productIndex && (
                <li>
                  <a class="nav-link" href={`/${encodePath(productIndex.slug)}`} aria-current={productIndex.slug === page.slug ? 'page' : undefined}>
                    <span class="nav-icon" set:html={icon(productIndex.icon ?? 'book-open', 16)} />
                    {productIndex.navTitle === page.product.name ? 'Introduction' : productIndex.navTitle}
                  </a>
                </li>
              )
            }
          </ul>
          <SidebarItems items={loose} current={page.slug} />
        </div>
        {
          sections.map((section) => (
            <div class="nav-section">
              <p class="nav-section-title">
                <span set:html={icon(section.icon ?? 'folder', 16)} />
                {section.title}
              </p>
              <SidebarItems
                items={section.slug ? [{ type: 'page', title: 'Overview', slug: section.slug, icon: null }, ...(section.type === 'group' ? section.children : [])] : section.type === 'group' ? section.children : []}
                current={page.slug}
              />
            </div>
          ))
        }
        <DrawerProducts current={page.product.id} />
      </nav>
    </aside>

    <main class="main" data-pagefind-body>
      <article class="article">
        <div class="article-head" data-pagefind-ignore>
          <p class="eyebrow">{eyebrow}</p>
          <div class="page-menu">
            <button class="page-menu-copy" type="button" data-markdown={markdownPath}>
              <Fragment set:html={icon('copy', 14)} />
              <span>Copy page</span>
            </button>
            <details class="page-menu-more">
              <summary aria-label="More page actions"><Fragment set:html={icon('chevron-down', 14)} /></summary>
              <div class="page-menu-list">
                <a href={markdownPath}>
                  <Fragment set:html={icon('file-text', 16)} />
                  <span><strong>View as Markdown</strong><small>The page as plain text</small></span>
                </a>
                <a href={`https://claude.ai/new?q=${askPrompt}`} target="_blank" rel="noopener">
                  <Fragment set:html={icon('sparkles', 16)} />
                  <span><strong>Open in Claude</strong><small>Ask questions about this page</small></span>
                </a>
                <a href={`https://chatgpt.com/?q=${askPrompt}`} target="_blank" rel="noopener">
                  <Fragment set:html={icon('message-square', 16)} />
                  <span><strong>Open in ChatGPT</strong><small>Ask questions about this page</small></span>
                </a>
              </div>
            </details>
          </div>
        </div>
        <h1 class="page-title" id={page.titleId ?? undefined}>{page.title}</h1>
        {page.description && <p class="page-lead">{page.description}</p>}
        {
          page.headings.length > 1 && (
            <details class="toc-mobile" data-pagefind-ignore>
              <summary>
                <Fragment set:html={icon('align-left', 14)} />
                On this page
                <Fragment set:html={icon('chevron-down', 14)} />
              </summary>
              <ul>
                {page.headings.map((h) => (
                  <li>
                    <a class={`depth-${h.depth}`} href={`#${h.id}`}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        <span data-pagefind-filter="product" data-pagefind-meta="product" data-pagefind-ignore hidden>{page.product.name}</span>
        <div class="prose" set:html={page.html} />

        <div class="page-actions" data-pagefind-ignore>
          {updated ? <span>Last updated {updated}</span> : <span />}
          {
            page.editUrl && (
              <a href={page.editUrl}>
                <Fragment set:html={icon('pencil', 14)} />
                Edit this page on GitHub
              </a>
            )
          }
        </div>
        <nav class="pager" aria-label="Previous and next page" data-pagefind-ignore>
          {
            prev && (
              <a class="prev" href={`/${encodePath(prev.slug)}`}>
                <small>Previous</small>
                <strong>{prev.navTitle}</strong>
              </a>
            )
          }
          {
            next && (
              <a class="next" href={`/${encodePath(next.slug)}`}>
                <small>Next</small>
                <strong>{next.navTitle}</strong>
              </a>
            )
          }
        </nav>
      </article>
    </main>

    <aside class="toc" aria-label="On this page" data-pagefind-ignore>
      {
        page.headings.length > 1 && (
          <>
            <p class="toc-title">
              <Fragment set:html={icon('align-left', 14)} />
              On this page
            </p>
            <ul>
              {page.headings.map((h) => (
                <li>
                  <a class={`depth-${h.depth}`} href={`#${h.id}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>
  </div>
</Base>
